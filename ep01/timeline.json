  "vo": [
    {"id": "v01", "t": 2.10, "text": "I woke up late."},
    {"id": "v02", "t": 3.90, "text": "For a meeting that no longer mattered."},
    {"id": "v03", "t": 15.80, "text": "At nine, the city was on time."},
    {"id": "v04", "t": 25.45, "text": "The buses were on time."},
    {"id": "v05", "t": 31.30, "text": "The lights were on time."},
    {"id": "v06", "t": 37.50, "text": "Even the coffee was ready."},
    {"id": "v07", "t": 42.90, "text": "There was just nobody left to be late."},
    {"id": "v08", "t": 46.70, "text": "For the first time in my life,"},
    {"id": "v09", "t": 48.75, "text": "I had nowhere to be."}
